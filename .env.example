NEXT_PUBLIC_SITE_URL=https://example.com

# --- Quorum + Loop widget ---
# Server-side key used to call the model for the Quorum (3-persona) and
# Loop (draft/critique/revise) widgets. Without this set, the widgets run
# in demo mode and return a friendly "not configured yet" message instead
# of erroring.
ANTHROPIC_API_KEY=

# Optional: override the hard per-visitor-session cost ceiling (USD) for a
# full Quorum -> Loop -> reaction sequence. Defaults to 0.30 if unset.
QUORUM_LOOP_BUDGET_USD=0.30

# Optional: override the coarse global daily spend ceiling (USD) across all
# visitors combined. Once crossed, the widget falls back to a friendly
# "check back tomorrow" message instead of placing more model calls.
# Defaults to 5.00 if unset. This is an in-memory, single-instance
# safeguard against volume abuse, not a precise multi-region budget system.
QUORUM_LOOP_DAILY_BUDGET_USD=5.00

# Cloudflare Turnstile keys, used to gate free-text submissions to the
# Quorum widget. Get a free site+secret key pair at
# https://dash.cloudflare.com/?to=/:account/turnstile
# Without these set, the captcha step is skipped (fine for local dev, not
# recommended in production since it removes the abuse/cost guard).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: comma-separated hostnames Turnstile responses must come from.
# Defaults to robertneyrinck.com,www.robertneyrinck.com in production (plus
# localhost/127.0.0.1 automatically outside production). Only set this if
# you're deploying under a different domain.
TURNSTILE_ALLOWED_HOSTNAMES=
